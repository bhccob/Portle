# Copy to .env.local for development. Never commit real values.

# Auth (required). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Encrypts broker provider tokens at rest. 32 random bytes, base64.
PORTLE_ENCRYPTION_KEY=

# Database. Leave empty to use the embedded PGlite database in .data/pglite.
# Staging/production: a PostgreSQL connection string.
DATABASE_URL=

# Market data: "demo" (synthetic, labelled) or "finnhub" (needs FINNHUB_API_KEY).
MARKET_DATA_PROVIDER=demo
FINNHUB_API_KEY=

# FX: "frankfurter" (ECB reference rates, no key) or "demo" (fixed, labelled).
FX_PROVIDER=frankfurter

# Email: without RESEND_API_KEY, mail goes to the local /dev/mailbox (development only).
RESEND_API_KEY=
MAIL_FROM="Portle <no-reply@example.com>"

# Brokerage aggregation (not yet enabled; see docs/ARCHITECTURE.md).
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Set to "off" only for automated end-to-end tests.
AUTH_RATE_LIMIT=
