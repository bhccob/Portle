# Copy to .env.local for development. Never commit real values.

# Auth (required). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The site address for auth links. On Vercel it defaults to the production address.
BETTER_AUTH_URL=http://localhost:3000

# Encrypts broker provider tokens at rest. 32 random bytes, base64.
PORTLE_ENCRYPTION_KEY=

# Database. Leave empty to use the embedded PGlite database in .data/pglite.
# Staging/production: a PostgreSQL connection string (required on Vercel). Migrations use
# DATABASE_URL_UNPOOLED instead when set, as the Neon integration does.
DATABASE_URL=

# Market data: "demo" (synthetic, labelled), "marketstack" (closing prices, needs MARKETSTACK_API_KEY)
# or "finnhub" (needs FINNHUB_API_KEY). marketstack counts every security asked about against the plan,
# so Portle keeps its prices until the next close.
MARKET_DATA_PROVIDER=demo
MARKETSTACK_API_KEY=
FINNHUB_API_KEY=

# FX: "frankfurter" (ECB reference rates, no key) or "demo" (fixed, labelled).
FX_PROVIDER=frankfurter

# Email: without RESEND_API_KEY, mail goes to the local /dev/mailbox (development only).
RESEND_API_KEY=
# Without a verified domain, use "Portle <onboarding@resend.dev>" (delivers to your Resend account email only).
MAIL_FROM="Portle <no-reply@example.com>"
# Shown on /contact. Without it, the page offers only GitHub issues.
CONTACT_EMAIL=

# Who runs this Portle (comma-separated sign-in emails). Owners always have full access (real prices and
# broker linking) and decide who else gets it under Settings → Full access. Without it, nobody has full access.
# Owners also wear the Founder tag and badge.
OWNER_EMAILS=
# The day Portle opens to everyone (YYYY-MM-DD). Members who joined before it keep the Early member badge.
# Leave empty while Portle is invite-only: everyone who joins until then is an early member.
EARLY_MEMBER_UNTIL=

# Broker sync through SnapTrade (a Commercial account's Client ID and Consumer Key). Without them, Connect broker explains it isn't switched on yet.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# How many brokers this Portle may link at once, across every member. Test keys (…-TEST-…) default to the free plan's 5.
BROKER_CONNECTION_LIMIT=

# Set to "off" only for automated end-to-end tests.
AUTH_RATE_LIMIT=
